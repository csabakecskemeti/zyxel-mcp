# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- switch connection -------------------------------------------------
ZYXEL_HOST=192.168.1.1          # switch management IP
ZYXEL_USER=admin
ZYXEL_PASSWORD=                 # or use ZYXEL_PASSWORD_FILE instead
#ZYXEL_PASSWORD_FILE=/run/secrets/zyxel_password
ZYXEL_SCHEME=http               # http or https

# --- safety ------------------------------------------------------------
# Ports where writes are always refused (uplinks, AP trunks, anything whose
# loss would cut your management path). Comma-separated.
ZYXEL_PROTECTED_PORTS=1,4

# --- operator artifacts (kept OUTSIDE this repo) -----------------------
# Where audit log and pre-write backups are written.
ZYXEL_AUDIT_LOG=~/network-state/zyxel-audit.jsonl
ZYXEL_BACKUP_DIR=~/network-state/backups

# Where `sync_snapshot` writes the rebuild-ready snapshot. Required for the
# sync tools; has no default so snapshots never land in this source tree.
ZYXEL_SYNC_DIR=~/network-state/switch-config

# Git remote that `sync_to_github` pushes the snapshot to. Required.
ZYXEL_SYNC_REMOTE=git@github.com:you/your-switch-config.git

# Optional: folder of markdown docs (VLAN plan, topology) exposed as MCP
# resources so the assistant can compare live state against intended design.
#ZYXEL_DOCS_DIR=~/network-state/docs

# Optional: DHCP lease/host file used to resolve MAC -> hostname.
#ZYXEL_DHCP_LEASES=/var/dhcpd/var/db/dhcpd.leases
